{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "ca.pem"
      }
    },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "ICONS/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js?__api_path=:path*" },
    { "source": "/", "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}